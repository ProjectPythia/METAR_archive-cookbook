:"W7xuxR6V8u"}],"key":"voMnB1ZCQv"}],"key":"kjEYdaTfk2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Uncomment whichever projection you want (or add your own!)\n#proj = ccrs.Stereographic(central_longitude=cLon, central_latitude=cLat)\nproj_map = ccrs.LambertConformal(central_longitude=cLon, central_latitude=cLat)","key":"iU7Itsdv8M"},{"type":"outputs","id":"lTp9gHy3E2KFoRCNX1BdY","children":[],"key":"x2yq80UJoR"}],"key":"hPdBsTCCem"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"proj_data = ccrs.PlateCarree()\nspacing = 150000 # meters; change depending on the map area\nxy = proj_map.transform_points(proj_data, lons, lats)\nmask = reduce_point_density(xy, spacing)","key":"BCdck79vFn"},{"type":"outputs","id":"p2HCdrzUGqA_XsRRQavuN","children":[],"key":"WC7gklkCzd"}],"key":"ZeEsVdGZtF"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"MmoO7C1ElQ"}],"key":"FHX8DpCo0E"},{"type":"paragraph","children":[{"type":"text","value":"In the call to ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QiN2WOBiYz"},{"type":"inlineCode","value":"transform_points","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eioBaqT4YD"},{"type":"text","value":", we pass in the arrays of the stations’ longitudes and latitudes. Since their units are in degrees, we need to also specify their corresponding map projection ... which is ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"W54X0OcXsd"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"PlateCarree","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tgr0g15ATn"}],"key":"ytdRVcfUCh"},{"type":"text","value