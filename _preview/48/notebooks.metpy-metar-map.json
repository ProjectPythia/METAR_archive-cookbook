","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"npMY6BoYwz"}],"key":"Np3EQukFoq"}],"key":"yi5gOePjpy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Uncomment whichever projection you want (or add your own!)\n#proj = ccrs.Stereographic(central_longitude=cLon, central_latitude=cLat)\nproj_map = ccrs.LambertConformal(central_longitude=cLon, central_latitude=cLat)","key":"i0PVjdXQEA"},{"type":"outputs","id":"EIvZdBvLu2jEtpsgoITyc","children":[],"key":"QXrqxHzJFC"}],"key":"CBqq5FCkdZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"proj_data = ccrs.PlateCarree()\nspacing = 150000 # meters; change depending on the map area\nxy = proj_map.transform_points(proj_data, lons, lats)\nmask = reduce_point_density(xy, spacing)","key":"UnHAbq453O"},{"type":"outputs","id":"g77qEhMimuPUVSWlF8hAj","children":[],"key":"PYbLX9juZw"}],"key":"Mlmov7XLze"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"H5Ch6t57Ea"}],"key":"xfgFPEJnIj"},{"type":"paragraph","children":[{"type":"text","value":"In the call to ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eL8Mm5pv30"},{"type":"inlineCode","value":"transform_points","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DXf2PSGnRE"},{"type":"text","value":", we pass in the arrays of the stations’ longitudes and latitudes. Since their units are in degrees, we need to also specify their corresponding map projection ... which is ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bnCOOXc3PQ"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"PlateCarree","position":{"start":{"line":1,"column":1},"end":{"line"