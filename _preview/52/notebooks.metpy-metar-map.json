rquet file for the specific year.","html_id":"open-the-geoparquet-file-for-the-specific-year","implicit":true,"key":"V8YRxHsMcl"}],"key":"c8stwULIEZ"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"df = duckdb.execute(\"\"\"\n    SELECT *\n    FROM read_parquet($1, hive_partitioning=true)\n    WHERE \n---      country = 'FR' AND\n---    station = 'ENGM' AND\n    valid BETWEEN $2 AND $3\n    ORDER BY country\n\"\"\", [URLs, time_0, time_1]).fetchdf()","visibility":"show","key":"RFVeGB23bw"},{"type":"outputs","id":"5y5372kXnjP9K-aguBoPj","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"FloatProgress(value=0.0, layout=Layout(width='auto'), style=ProgressStyle(bar_color='black'))","content_type":"text/plain"},"application/vnd.jupyter.widget-view+json":{"content":"{\"version_major\":2,\"version_minor\":0,\"model_id\":\"e55c323ca03b423c9c625fb9de8440d7\"}","content_type":"application/vnd.jupyter.widget-view+json"}}},"key":"OenG6F58Kx"}],"visibility":"show","key":"LGGvSeRbAn"}],"visibility":"show","key":"ZeQKPPSmT6"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Perform the spatial subset. Extend the data bounds slightly.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vBzw6AAfFg"}],"key":"tZIeosy88w"}],"key":"EZ2BvJOIVb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"extend = 1\ndf2 = df.query('latitude >= (@latS - @extend) & latitude <= (@latN + @extend) & longitude  >= (@lonW - @extend) & longitude <= (@lonE + @extend)')","key":"OnmqhfXu5A"},{"type":"outputs","id":"kUQ2lpeWn8vj2s4A6Ezhw","children":[],"key":"IPC0i2ndpU"}],"key":"fOFCZBwSDC"},{"type":"block","kind":"notebook-content