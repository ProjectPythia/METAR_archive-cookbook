,"end":{"line":1,"column":1}},"key":"DIT50lRCgZ"}],"key":"kn1qpj0VVW"}],"key":"QcVq4dC94d"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Uncomment whichever projection you want (or add your own!)\n#proj = ccrs.Stereographic(central_longitude=cLon, central_latitude=cLat)\nproj_map = ccrs.LambertConformal(central_longitude=cLon, central_latitude=cLat)","key":"MsaNgmymNO"},{"type":"outputs","id":"BJNYz4W3MrS3YmqAxHYUp","children":[],"key":"eG85hQKfVI"}],"key":"s7we5hJEFZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"proj_data = ccrs.PlateCarree()\nspacing = 150000 # meters; change depending on the map area\nxy = proj_map.transform_points(proj_data, lons, lats)\nmask = reduce_point_density(xy, spacing)","key":"y1wwIibJbK"},{"type":"outputs","id":"IAol2kYsfLhj0IeEP7oy1","children":[],"key":"yw2C6kFtWO"}],"key":"XTHLUqyjMv"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"xOGp9NsVeT"}],"key":"c7P30ApKOD"},{"type":"paragraph","children":[{"type":"text","value":"In the call to ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yQJz6ncQ3s"},{"type":"inlineCode","value":"transform_points","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jo3YsQafoX"},{"type":"text","value":", we pass in the arrays of the stations’ longitudes and latitudes. Since their units are in degrees, we need to also specify their corresponding map projection ... which is ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kI3ymiLyTV"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"PlateCarree","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rLboV2kEZU"}],"key":