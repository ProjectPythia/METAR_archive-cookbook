ey":"EATfKleR94"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The timestamps of many hourly METAR reports are 5-10 minutes prior to the top of the hour, though there are also intra-hourly reports, often around 15-20 and 35-40 minutes past the hour. When we make our DuckDB query, we will specify a beginning and end time, 15 minutes apart.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cKL62VKH4i"}],"key":"z2YYnsnn1P"}],"key":"ntkqT5pqbY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"time_0 = time_1 - timedelta(minutes=15)\nYYYY_0 = time_0.strftime(\"%Y\")\nYYYY_1 = time_1.strftime(\"%Y\")\ndate_string = time_1.strftime(\"%Y-%m-%d %H00 UTC\")\nprint(time_0, time_1)\n# Handle edge case when the two hours straddle the end/beginning of a yearw\nif (YYYY_0 == YYYY_1):\n    URLs = [f'https://data.source.coop/dynamical/asos-parquet/year={YYYY_1}/data.parquet']\nelse:\n    URLs = [f'https://data.source.coop/dynamical/asos-parquet/year={YYYY_0}/data.parquet',\n            f'https://data.source.coop/dynamical/asos-parquet/year={YYYY_1}/data.parquet']\n","key":"gzX7LIYvv7"},{"type":"outputs","id":"hEzkKPstuwFkkV2HmDTSH","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"2026-08-31 19:13:31.925507 2026-08-31 19:28:31.925507\n"},"key":"Zlry1qJh2b"}],"key":"D6rv9gChPb"}],"key":"drUY4tGp5D"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Open the GeoParquet file for the specific year.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EZzTkpseCi"}],"identifier":"open-the-geoparquet-file-for-the-specific-year","label":"Open the GeoParquet file for the specific year.","html_id":"open-the-geoparquet-file-for-the-specific-year","implicit":true,"key":"QEpqBZhKP8"}],"key":"he4SVRVQjm"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"df = duckdb.execute(\"\"\"\n    SELECT *\n    FROM read_parquet($1, hive_partitioning=true)\n    WHERE \n---      country = 'FR' AND\n---    station = 'ENGM' AND\n    valid BETWEEN $2 AND $3\n    ORDER BY country\n\"\"\", [URLs, time_0, time_1]).fetchdf()","visibility":"show","key":"S911Mqjqtc"},{"type":"outputs","id":"zOCaZ_dbc8SOo0vbYH4gT","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"FloatProgress(value=0.0, layout=Layout(width='auto'), style=ProgressStyle(bar_color='black'))","content_type":"text/plain"},"application/vnd.jupyter.widget-view+json":{"content":"{\"version_major\":2,\"version_minor\":0,\"model_id\":\"cf70127f7581418a8d671793d85278f8\"}","content_type":"application/vnd.jupyter.widget-view+json"}}},"key":"oCZ9xa9SmE"}],"visibility":"show","key":"QcwDblttn3"}],"visibility":"show","key":"BF4ZI4tHIY"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Perform the spatial subset. Extend the data bounds slightly.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MoEfgh9XBC"}],"key":"NXPESSwKVX"}],"key":"KkiaogBARf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"extend = 1\ndf2 = df.query('latitude >= (@latS - @extend) & latitude <= (@latN + @extend) & longitude  >= (@lonW - @extend) & longitude <= (@lonE + @extend)')","key":"gEMbIWcpw8"},{"type":"outputs","id":"9y95N8aaP9wZUQt8awCRn","children":[],"key":"jW3egqt1dc"}],"key":"NoMXg2CGZi"},{"type":"block","kind":"notebook-content