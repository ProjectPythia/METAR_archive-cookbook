ey":"Wu3orXVw4t"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The timestamps of many hourly METAR reports are 5-10 minutes prior to the top of the hour, though there are also intra-hourly reports, often around 15-20 and 35-40 minutes past the hour. When we make our DuckDB query, we will specify a beginning and end time, 15 minutes apart.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NAu4zTQEon"}],"key":"t8F3pNNck6"}],"key":"uQEvJvzPam"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"time_0 = time_1 - timedelta(minutes=15)\nYYYY_0 = time_0.strftime(\"%Y\")\nYYYY_1 = time_1.strftime(\"%Y\")\ndate_string = time_1.strftime(\"%Y-%m-%d %H00 UTC\")\nprint(time_0, time_1)\n# Handle edge case when the two hours straddle the end/beginning of a yearw\nif (YYYY_0 == YYYY_1):\n    URLs = [f'https://data.source.coop/dynamical/asos-parquet/year={YYYY_1}/data.parquet']\nelse:\n    URLs = [f'https://data.source.coop/dynamical/asos-parquet/year={YYYY_0}/data.parquet',\n            f'https://data.source.coop/dynamical/asos-parquet/year={YYYY_1}/data.parquet']\n","key":"idzOqFzO6f"},{"type":"outputs","id":"9eO_M145G7VlX7yWU9rbk","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"2026-08-26 19:51:08.220232 2026-08-26 20:06:08.220232\n"},"key":"Pf1Nf5Fl1q"}],"key":"pKtmkkfqkq"}],"key":"JKiaSVmrYJ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Open the GeoParquet file for the specific year.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sBtYsoFwan"}],"identifier":"open-the-geoparquet-file-for-the-specific-year","label":"Open the GeoParquet file for the specific year.","html_id":"open-the-geoparquet-file-for-the-specific-year","implicit":true,"key":"nyiLgPvVrZ"}],"key":"glM8xAte1R"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"df = duckdb.execute(\"\"\"\n    SELECT *\n    FROM read_parquet($1, hive_partitioning=true)\n    WHERE \n---      country = 'FR' AND\n---    station = 'ENGM' AND\n    valid BETWEEN $2 AND $3\n    ORDER BY country\n\"\"\", [URLs, time_0, time_1]).fetchdf()","visibility":"show","key":"bxZIFzyHNO"},{"type":"outputs","id":"6l0j4j_g70E4bv7Tuq0ya","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"FloatProgress(value=0.0, layout=Layout(width='auto'), style=ProgressStyle(bar_color='black'))","content_type":"text/plain"},"application/vnd.jupyter.widget-view+json":{"content":"{\"version_major\":2,\"version_minor\":0,\"model_id\":\"913c4c0102f64f2d92c5414646494fcb\"}","content_type":"application/vnd.jupyter.widget-view+json"}}},"key":"AB5xmEuozL"}],"visibility":"show","key":"suHsUnfu3d"}],"visibility":"show","key":"eNGM5R1eaG"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Perform the spatial subset. Extend the data bounds slightly.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oK7s6qnR3m"}],"key":"guA1dJn7od"}],"key":"bCposlRbUa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"extend = 1\ndf2 = df.query('latitude >= (@latS - @extend) & latitude <= (@latN + @extend) & longitude  >= (@lonW - @extend) & longitude <= (@lonE + @extend)')","key":"riCYwA3n3C"},{"type":"outputs","id":"Ziotagn46SjXUcTmR0q0W","children":[],"key":"GyPu8rfUfj"}],"key":"ZjAHHHwfKg"},{"type":"block","kind":"notebook-content