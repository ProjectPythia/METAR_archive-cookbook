c import wind_components, reduce_point_density\nfrom metpy.units import units\nfrom metpy.plots import StationPlot\nfrom metpy.plots.wx_symbols import current_weather, sky_cover, wx_code_map","key":"ZnFLQKWh6i"},{"type":"outputs","id":"loOJo1sWhaeg9BplDQher","children":[],"key":"sv66F2OJya"}],"key":"HYu9oXw91p"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Set the domain to gather data from and for defining the plot region.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HnCGRtG7nt"}],"identifier":"set-the-domain-to-gather-data-from-and-for-defining-the-plot-region","label":"Set the domain to gather data from and for defining the plot region.","html_id":"set-the-domain-to-gather-data-from-and-for-defining-the-plot-region","implicit":true,"key":"Aqc8qvJeco"}],"key":"uzsciGHNoi"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"latN = 55\nlatS = 20\nlonW = -125\nlonE = -60\n\ncLat = (latN + latS) / 2\ncLon = (lonW + lonE) / 2","key":"EZ3TIKJzBe"},{"type":"outputs","id":"D9YrzQF6hgk3O_NF12XUb","children":[],"key":"I3kEVyjkg3"}],"key":"Ks9LgiJ9Dd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Use the current time, or set your own for a past time.\n# Set current to False if you want to specify a past time.\n\nnowTime = datetime.now()\n\ncurrent = True\n#current = False\nif (current):\n    time_1 = datetime.now()\n    offset = timedelta(hours = 1) # Worldwide METARS typically don't come in until ~15 minutes past the hour\n    time_1 = time_1 - offset\nelse:\n    year = 2026\n    month = 6\n    day = 18\n    hour = 18\n    time_1 = datetime(year, month, day, hour)","key":"GHmvP5jVcB"},{"type":"outputs","id":"LflvNm_kfvcq3HQ8PIwTq","children":[],"key":"ytTNFG9hGj"}],"key":"PVb7YXrD8K"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The timestamps of many hourly METAR reports are 5-10 minutes prior to the top of the hour, though there are also intra-hourly reports, often around 15-20 and 35-40 minutes past the hour. When we make our DuckDB query, we will specify a beginning and end time, 15 minutes apart.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sS85x3E3sw"}],"key":"PqxhzO5atN"}],"key":"hSUkuGpnMd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"time_0 = time_1 - timedelta(minutes=15)\nYYYY_0 = time_0.strftime(\"%Y\")\nYYYY_1 = time_1.strftime(\"%Y\")\ndate_string = time_1.strftime(\"%Y-%m-%d %H00 UTC\")\nprint(time_0, time_1)\n# Handle edge case when the two hours straddle the end/beginning of a yearw\nif (YYYY_0 == YYYY_1):\n    URLs = [f'https://data.source.coop/dynamical/asos-parquet/year={YYYY_1}/data.parquet']\nelse:\n    URLs = [f'https://data.source.coop/dynamical/asos-parquet/year={YYYY_0}/data.parquet',\n            f'https://data.source.coop/dynamical/asos-parquet/year={YYYY_1}/data.parquet']\n","key":"jmdm2LKfI7"},{"type":"outputs","id":"Uo7AsAQ2kn3tocXlUhup0","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"2026-11-25 06:47:37.299414 2026-11-25 07:02:37.299414\n"},"key":"S94arb3wyV"}],"key":"yp6Cp8mBLy"}],"key":"f9bBNF2tDi"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Open the GeoParquet file for the specific year.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GJL6mH1qOC"}],"identifier":"open-the-geoparquet-file-for-the-specific-year","label":"Open the GeoParquet file