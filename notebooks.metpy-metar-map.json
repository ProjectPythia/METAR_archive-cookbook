","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"N8NAkEWNrJ"}],"key":"XpQu8cGBQo"}],"key":"B01sRtoAib"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Uncomment whichever projection you want (or add your own!)\n#proj = ccrs.Stereographic(central_longitude=cLon, central_latitude=cLat)\nproj_map = ccrs.LambertConformal(central_longitude=cLon, central_latitude=cLat)","key":"RKwvDs8riY"},{"type":"outputs","id":"zhPtvyPC-spvzm0mBkt6j","children":[],"key":"J7Jr8Em28e"}],"key":"sVFh013Pwx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"proj_data = ccrs.PlateCarree()\nspacing = 150000 # meters; change depending on the map area\nxy = proj_map.transform_points(proj_data, lons, lats)\nmask = reduce_point_density(xy, spacing)","key":"ZzQe68sQBd"},{"type":"outputs","id":"YG5lDbqanphTJtmGmmHPC","children":[],"key":"PBRIhVIUl3"}],"key":"MiXRFmB3hn"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"kg3ihgINBu"}],"key":"I59cm4QL2B"},{"type":"paragraph","children":[{"type":"text","value":"In the call to ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ekuT7sQZxp"},{"type":"inlineCode","value":"transform_points","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ueK2OF3ei0"},{"type":"text","value":", we pass in the arrays of the stations’ longitudes and latitudes. Since their units are in degrees, we need to also specify their corresponding map projection ... which is ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zGkk7jRSzF"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"PlateCarree","position":{"start":{"line":1,"column":1},"end":{"line"