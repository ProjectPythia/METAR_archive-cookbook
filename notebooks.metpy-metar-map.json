n a map.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XE5IWpsJkD"}],"key":"kFUSjotHeb"}],"key":"BpX7RLRSYr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Uncomment whichever projection you want (or add your own!)\n#proj = ccrs.Stereographic(central_longitude=cLon, central_latitude=cLat)\nproj_map = ccrs.LambertConformal(central_longitude=cLon, central_latitude=cLat)","key":"ZliMNK0r1r"},{"type":"outputs","id":"TGM2d9zixpcOMsbxNKUCE","children":[],"key":"G8RnWzXi0C"}],"key":"uFZBCsDua8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"proj_data = ccrs.PlateCarree()\nspacing = 150000 # meters; change depending on the map area\nxy = proj_map.transform_points(proj_data, lons, lats)\nmask = reduce_point_density(xy, spacing)","key":"rRnsv22MH2"},{"type":"outputs","id":"gEooYZcqL2z_UF8vti2CZ","children":[],"key":"Xsm4yz2yOx"}],"key":"yoK5wsLyYd"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"KS96IVwfNx"}],"key":"Zl39m1emzR"},{"type":"paragraph","children":[{"type":"text","value":"In the call to ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"x2uIyx43sL"},{"type":"inlineCode","value":"transform_points","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KhFnlU0b7M"},{"type":"text","value":", we pass in the arrays of the stations’ longitudes and latitudes. Since their units are in degrees, we need to also specify their corresponding map projection ... which is ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AEhIIlr1xs"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"PlateCarree","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ErLTA4LrQc"}],"key":"gQ1T4sY4lh"},{"type":"text","value":" for degrees of longitude and latitude.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"i8ziiVx2hB"}],"key":"tvkTSEQUxi"}],"key":"bnZATlpVoN"}],"key":"RGMb4ECXtS"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Visualize Surface Observations","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pwlkYTWaxh"}],"identifier":"visualize-surface-observations","label":"Visualize Surface Observations","html_id":"visualize-surface-observations","implicit":true,"key":"d9rDWLPfd0"}],"key":"eF634n7tro"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Simple station plotting using plot methods","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tHzffSf7IV"}],"identifier":"simple-station-plotting-using-plot-methods","label":"Simple station plotting using plot methods","html_id":"simple-station-plotting-using-plot-methods","implicit":true,"key":"zQORVijEYn"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"One way to create station plots with MetPy is to create an instance of ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"txVRXqtIsr"},{"type":"inlineCode","value":"StationPlot","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"LalREUAsiG"},{"type":"text","value":" and call various plot methods, like ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"R5vu9ZcrcB"},{"type":"inlineCode","value":"plot_parameter","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"sPkUg5LOrx"},{"type":"text","value":", to plot arrays of data at locations relative to the center point.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Y1KlcS16cC"}],"key":"y5ZbPkML4I"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"In addition to plotting values, ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"lo3RZGNciE"},{"type":"inlineCode","value":"StationPlot","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Becs552uwS"},{"type":"text","value":" has support for plotting text strings, symbols, and plotting values using custom formatting.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"SBzB7k4rZN"}],"key":"cltkTXJyjI"}],"key":"R5KGR9K8fJ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now we just plot with ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"u4uBGfRA6U"},{"type":"inlineCode","value":"arr[mask]","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"o9BVXdk3oY"},{"type":"text","value":" for every ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"y75g6pcRdW"},{"type":"inlineCode","value":"arr","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JzoC1EJsHz"},{"type":"text","value":" of data we use in plotting.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pKa8cQ1yoW"}],"key":"mfBE0fbnOk"}],"key":"R00bt02cdX"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"# Set up a plot with map features\n# First set dpi (\"dots per inch\") - higher values will give us a less pixelated final figure.\ndpi = 125\n\nfig = plt.figure(figsize=(20,12), dpi=dpi)\n\nax = fig.add_subplot(1, 1, 1, projection=proj_map) # We use the projection defined above\nax.set_facecolor(cfeature.COLORS['water'])\n\nland_mask = cfeature.NaturalEarthFeature('physical', 'land', '50m',\n                                        edgecolor='face',\n                                        facecolor=cfeature.COLORS['land'])\nlake_mask = cfeature.NaturalEarthFeature('physical', 'lakes', '50m',\n                                        edgecolor='face',\n                                        facecolor=cfeature.COLORS['water'])\nstate_borders = cfeature.NaturalEarthFeature(category='cultural', name='admin_1_states_provinces_lakes',\n                                         scale='50m', facecolor='none')\n\nax.add_feature(land_mask)\nax.add_feature(lake_mask)\nax.add_feature(state_borders, linestyle='solid', edgecolor='black')\n\nax.set_extent ((lonW, lonE, latS, latN), crs=proj_data)\n\n#If we wanted to add grid lines to our plot:\n#ax.gridlines()\n\n# Create a station plot pointing to an Axes to draw on as well as the location of points\nstationplot = StationPlot(ax, lons[mask], lats[mask], transform=ccrs.PlateCarree(),\n                          fontsize=8)\n\nstationplot.plot_parameter('NW', tair[mask], color='red', fontsize=10)\nstationplot.plot_parameter('SW', dewp[mask], color='darkgreen', fontsize=10)\n\n# Below, we are using a custom formatter to control how the sea-level pressure\n# values are plotted. This uses the standard trailing 3-digits of the pressure value\n# in tenths of millibars.\nstationplot.plot_parameter('NE', slp[mask], color='purple', formatter=lambda v: format(10 * v, '.0f')[-3:])\n\n\n\n#stationplot.plot_symbol('C', cloud_cover[mask], sky_cover)\n#stationplot.plot_symbol('W', wnum[mask], current_weather,color='blue',fontsize=12)\nstationplot.plot_text((2, 0),stid[mask], color='gray')\n#zorder - Higher value zorder will plot the variable on top of lower value zorder. This is necessary for wind barbs to appear. Default is 1.\nstationplot.plot_barb(u[mask], v[mask],zorder=2)\n\n# Remove any text that appears outside the borders of the Axes\n\nfor obj in ax.findobj(mtext.Text):\n    obj.set_clip_on(True)\nplotTitle = (f\"Sfc Map valid at:  {date_string}\")\nax.set_title (plotTitle);","key":"EmF9U6HPQj"},{"type":"outputs","id":"qetHDD-4p7PU9mM5ttgpV","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stderr","text":"/home/runner/micromamba/envs/METAR_archive-cookbook/lib/python3.14/site-packages/cartopy/io/__init__.py:263: DownloadWarning: Downloading: https://naturalearth.s3.amazonaws.com/50m_physical/ne_50m_land.zip\n  warnings.warn(f'Downloading: {url}', DownloadWarning)\n"},"key":"TRXnxxtR5e"},{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stderr","text":"/home/runner/micromamba/envs/METAR_archive-cookbook/lib/python3.14/site-packages/cartopy/io/__init__.py:263: DownloadWarning: Downloading: https://naturalearth.s3.amazonaws.com/50m_physical/ne_50m_lakes.zip\n  warnings.warn(f'Downloading: {url}', DownloadWarning)\n"},"key":"idS3sr1y8A"},{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stderr","text":"/home/runner/micromamba/envs/METAR_archive-cookbook/lib/python3.14/site-packages/cartopy/io/__init__.py:263: DownloadWarning: Downloading: https://naturalearth.s3.amazonaws.com/50m_cultural/ne_50m_admin_1_states_provinces_lakes.zip\n  warnings.warn(f'Downloading: {url}', DownloadWarning)\n"},"key":"A6MAzKIgNJ"},{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 2500x1500 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"1f638ecd81d636b7c0fea488a9fe0af6","path":"/METAR_archive-cookbook/build/1f638ecd81d636b7c0fea488a9fe0af6.png"}}},"key":"hzlL9CaTsx"}],"key":"ht22wC6zNM"}],"key":"dTUv6lgRKG"},{"type":"block","k