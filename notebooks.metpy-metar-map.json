d1c"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The timestamps of many hourly METAR reports are 5-10 minutes prior to the top of the hour, though there are also intra-hourly reports, often around 15-20 and 35-40 minutes past the hour. When we make our DuckDB query, we will specify a beginning and end time, 15 minutes apart.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ljAXnVWVXA"}],"key":"sTT6npjNJN"}],"key":"ZjEXAcyH6c"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"time_0 = time_1 - timedelta(minutes=15)\nYYYY_0 = time_0.strftime(\"%Y\")\nYYYY_1 = time_1.strftime(\"%Y\")\ndate_string = time_1.strftime(\"%Y-%m-%d %H00 UTC\")\nprint(time_0, time_1)\n# Handle edge case when the two hours straddle the end/beginning of a yearw\nif (YYYY_0 == YYYY_1):\n    URLs = [f'https://data.source.coop/dynamical/asos-parquet/year={YYYY_1}/data.parquet']\nelse:\n    URLs = [f'https://data.source.coop/dynamical/asos-parquet/year={YYYY_0}/data.parquet',\n            f'https://data.source.coop/dynamical/asos-parquet/year={YYYY_1}/data.parquet']\n","key":"EsF4oqgkLU"},{"type":"outputs","id":"mjNufH12iDSoV9s7XpZlv","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"2026-09-17 03:19:54.160837 2026-09-17 03:34:54.160837\n"},"key":"yPTweQGgdB"}],"key":"IJy9pqMwvd"}],"key":"RjhRLpRPez"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Open the GeoParquet file for the specific year.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"l9wB4XxFlq"}],"identifier":"open-the-geoparquet-file-for-the-specific-year","label":"Open the GeoParquet file f