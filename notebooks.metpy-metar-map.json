s","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Uc5wOUajro"},{"type":"text","value":", we pass in the arrays of the stations’ longitudes and latitudes. Since their units are in degrees, we need to also specify their corresponding map projection ... which is ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lz6RyGunCG"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"PlateCarree","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pjNXfQem7C"}],"key":"MJTEFVwV1O"},{"type":"text","value":" for degrees of longitude and latitude.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dw9EVAzmnb"}],"key":"I1k8EBRyJQ"}],"key":"p9irCpDqfM"}],"key":"gQSTmtyVYX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Visualize Surface Observations","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AbNDM5cFM1"}],"identifier":"visualize-surface-observations","label":"Visualize Surface Observations","html_id":"visualize-surface-observations","implicit":true,"key":"BRA8jFQPod"}],"key":"pMf3RYvnKN"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Simple station plotting using plot methods","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WQiLQnXRks"}],"identifier":"simple-station-plotting-using-plot-methods","label":"Simple station plotting using plot methods","html_id":"simple-station-plotting-using-plot-methods","implicit":true,"key":"sCN18StNHT"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"One way to create station plots with MetPy is to create an instance of ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"A4RnXe6h18"},{"type":"inlineCode","value":"StationPlot","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Kp3axeUfxl"},{"type":"text","value":" and call various plot methods, like ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PZ1i4bsCGr"},{"type":"inlineCode","value":"plot_parameter","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"m693mNUhPN"},{"type":"text","value":", to plot arrays of data at locations relative to the center point.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ipzqow4XC2"}],"key":"RnOF0INxIK"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"In addition to plotting values, ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Px96XAqmIp"},{"type":"inlineCode","value":"StationPlot","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"JWK80YLcEr"},{"type":"text","value":" has support for plotting text strings, symbols, and plotting values using custom formatting.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"bc5vxi2xsI"}],"key":"uc26PFKKd4"}],"key":"XqdgnU2sqR"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now we just plot with ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"X4rRBiIYtf"},{"type":"inlineCode","value":"arr[mask]","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ycezSLHTX0"},{"type":"text","value":" for every ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OZfjHf2gmk"},{"type":"inlineCode","value":"arr","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AuxETyNc9y"},{"type":"text","value":" of data we use in plotting.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fdGsQYfobq"}],"key":"jylRmtlVMV"}],"key":"BkB2ZMPczS"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"# Set up a plot with map features\n# First set dpi (\"dots per inch\") - higher values will give us a less pixelated final figure.\ndpi = 125\n\nfig = plt.figure(figsize=(20,12), dpi=dpi)\n\nax = fig.add_subplot(1, 1, 1, projection=proj_map) # We use the projection defined above\nax.set_facecolor(cfeature.COLORS['water'])\n\nland_mask = cfeature.NaturalEarthFeature('physical', 'land', '50m',\n                                        edgecolor='face',\n                                        facecolor=cfeature.COLORS['land'])\nlake_mask = cfeature.NaturalEarthFeature('physical', 'lakes', '50m',\n                                        edgecolor='face',\n                                        facecolor=cfeature.COLORS['water'])\nstate_borders = cfeature.NaturalEarthFeature(category='cultural', name='admin_1_states_provinces_lakes',\n                                         scale='50m', facecolor='none')\n\nax.add_feature(land_mask)\nax.add_feature(lake_mask)\nax.add_feature(state_borders, linestyle='solid', edgecolor='black')\n\nax.set_extent ((lonW, lonE, latS, latN), crs=proj_data)\n\n#If we wanted to add grid lines to our plot:\n#ax.gridlines()\n\n# Create a station plot pointing to an Axes to draw on as well as the location of points\nstationplot = StationPlot(ax, lons[mask], lats[mask], transform=ccrs.PlateCarree(),\n                          fontsize=8)\n\nstationplot.plot_parameter('NW', tair[mask], color='red', fontsize=10)\nstationplot.plot_parameter('SW', dewp[mask], color='darkgreen', fontsize=10)\n\n# Below, we are using a custom formatter to control how the sea-level pressure\n# values are plotted. This uses the standard trailing 3-digits of the pressure value\n# in tenths of millibars.\nstationplot.plot_parameter('NE', slp[mask], color='purple', formatter=lambda v: format(10 * v, '.0f')[-3:])\n\n\n\n#stationplot.plot_symbol('C', cloud_cover[mask], sky_cover)\n#stationplot.plot_symbol('W', wnum[mask], current_weather,color='blue',fontsize=12)\nstationplot.plot_text((2, 0),stid[mask], color='gray')\n#zorder - Higher value zorder will plot the variable on top of lower value zorder. This is necessary for wind barbs to appear. Default is 1.\nstationplot.plot_barb(u[mask], v[mask],zorder=2)\n\n# Remove any text that appears outside the borders of the Axes\n\nfor obj in ax.findobj(mtext.Text):\n    obj.set_clip_on(True)\nplotTitle = (f\"Sfc Map valid at:  {date_string}\")\nax.set_title (plotTitle);","key":"b4XsJIbub8"},{"type":"outputs","id":"i8XVwMNe5hmZBe4z76sPQ","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stderr","text":"/home/runner/micromamba/envs/METAR_archive-cookbook/lib/python3.14/site-packages/cartopy/io/__init__.py:263: DownloadWarning: Downloading: https://naturalearth.s3.amazonaws.com/50m_physical/ne_50m_land.zip\n  warnings.warn(f'Downloading: {url}', DownloadWarning)\n"},"key":"XTlVQ9LYF8"},{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stderr","text":"/home/runner/micromamba/envs/METAR_archive-cookbook/lib/python3.14/site-packages/cartopy/io/__init__.py:263: DownloadWarning: Downloading: https://naturalearth.s3.amazonaws.com/50m_physical/ne_50m_lakes.zip\n  warnings.warn(f'Downloading: {url}', DownloadWarning)\n"},"key":"bw0xDXnfHw"},{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stderr","text":"/home/runner/micromamba/envs/METAR_archive-cookbook/lib/python3.14/site-packages/cartopy/io/__init__.py:263: DownloadWarning: Downloading: https://naturalearth.s3.amazonaws.co