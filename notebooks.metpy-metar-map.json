dwt"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The timestamps of many hourly METAR reports are 5-10 minutes prior to the top of the hour, though there are also intra-hourly reports, often around 15-20 and 35-40 minutes past the hour. When we make our DuckDB query, we will specify a beginning and end time, 15 minutes apart.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wAFeafxAZ3"}],"key":"LHVvOS4x03"}],"key":"Z3C5VuLjJo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"time_0 = time_1 - timedelta(minutes=15)\nYYYY_0 = time_0.strftime(\"%Y\")\nYYYY_1 = time_1.strftime(\"%Y\")\ndate_string = time_1.strftime(\"%Y-%m-%d %H00 UTC\")\nprint(time_0, time_1)\n# Handle edge case when the two hours straddle the end/beginning of a yearw\nif (YYYY_0 == YYYY_1):\n    URLs = [f'https://data.source.coop/dynamical/asos-parquet/year={YYYY_1}/data.parquet']\nelse:\n    URLs = [f'https://data.source.coop/dynamical/asos-parquet/year={YYYY_0}/data.parquet',\n            f'https://data.source.coop/dynamical/asos-parquet/year={YYYY_1}/data.parquet']\n","key":"ogp1Xfq3MM"},{"type":"outputs","id":"_y2pSZLSBL3agm19miOFV","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"2026-10-18 02:53:27.528050 2026-10-18 03:08:27.528050\n"},"key":"OrQXLQ0pxL"}],"key":"RZLRPCRUQ1"}],"key":"X1KAmyALrd"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Open the GeoParquet file for the specific year.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"k0FjCARtif"}],"identifier":"open-the-geoparquet-file-for-the-specific-year","label":"Open the GeoParquet file f