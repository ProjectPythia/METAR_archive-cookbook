c import wind_components, reduce_point_density\nfrom metpy.units import units\nfrom metpy.plots import StationPlot\nfrom metpy.plots.wx_symbols import current_weather, sky_cover, wx_code_map","key":"Iqzg2JguLY"},{"type":"outputs","id":"ZN1zRHT4h-fZxkOVZnhoS","children":[],"key":"GkXpDofGgM"}],"key":"XHdPC033uf"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Set the domain to gather data from and for defining the plot region.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"z1vGSGbrOr"}],"identifier":"set-the-domain-to-gather-data-from-and-for-defining-the-plot-region","label":"Set the domain to gather data from and for defining the plot region.","html_id":"set-the-domain-to-gather-data-from-and-for-defining-the-plot-region","implicit":true,"key":"HfVI3E2ofE"}],"key":"es6b21y6Mz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"latN = 55\nlatS = 20\nlonW = -125\nlonE = -60\n\ncLat = (latN + latS) / 2\ncLon = (lonW + lonE) / 2","key":"i0eb3NQZ8e"},{"type":"outputs","id":"JiJ2_j8F-OYgXFx443j7j","children":[],"key":"IYft5owTMh"}],"key":"MnfFioIbDj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Use the current time, or set your own for a past time.\n# Set current to False if you want to specify a past time.\n\nnowTime = datetime.now()\n\ncurrent = True\n#current = False\nif (current):\n    time_1 = datetime.now()\n    offset = timedelta(hours = 1) # Worldwide METARS typically don't come in until ~15 minutes past the hour\n    time_1 = time_1 - offset\nelse:\n    year = 2026\n    month = 6\n    day = 18\n    hour = 18\n    time_1 = datetime(year, month, day, hour)","key":"mPfpX7cyzK"},{"type":"outputs","id":"9ItQJVA6QXNimr4nWRyQa","children":[],"key":"WsiiDe1bxs"}],"key":"o01PB5uwEr"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The timestamps of many hourly METAR reports are 5-10 minutes prior to the top of the hour, though there are also intra-hourly reports, often around 15-20 and 35-40 minutes past the hour. When we make our DuckDB query, we will specify a beginning and end time, 15 minutes apart.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dfeG8njKja"}],"key":"INfg59gXfJ"}],"key":"X1O65xR0DU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"time_0 = time_1 - timedelta(minutes=15)\nYYYY_0 = time_0.strftime(\"%Y\")\nYYYY_1 = time_1.strftime(\"%Y\")\ndate_string = time_1.strftime(\"%Y-%m-%d %H00 UTC\")\nprint(time_0, time_1)\n# Handle edge case when the two hours straddle the end/beginning of a yearw\nif (YYYY_0 == YYYY_1):\n    URLs = [f'https://data.source.coop/dynamical/asos-parquet/year={YYYY_1}/data.parquet']\nelse:\n    URLs = [f'https://data.source.coop/dynamical/asos-parquet/year={YYYY_0}/data.parquet',\n            f'https://data.source.coop/dynamical/asos-parquet/year={YYYY_1}/data.parquet']\n","key":"YzM40UF2su"},{"type":"outputs","id":"Mb9VlsGnhvUVyDkR1qpGV","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"2026-11-24 08:17:26.962228 2026-11-24 08:32:26.962228\n"},"key":"GFOchrHZG7"}],"key":"jZuYwjhqHQ"}],"key":"X9fPVZv9Vh"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Open the GeoParquet file for the specific year.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BjT7OUgCXP"}],"identifier":"open-the-geoparquet-file-for-the-specific-year","label":"Open the GeoParquet file for the specific year.","html_id":"open-the-geoparquet-file-for-the-specific-year","implicit":true,"key":"uu0BW8K1Qp"}],"key":"iSeiEwh8iN"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"df = duckdb.execute(\"\"\"\n    SELECT *\n    FROM read_parquet($1, hive_partitioning=true)\n    WHERE \n---      country = 'FR' AND\n---    station = 'ENGM' AND\n    valid BETWEEN $2 AND $3\n    ORDER BY country\n\"\"\", [URLs, time_0, time_1]).fetchdf()","visibility":"show","key":"SIsPaaJyyh"},{"type":"outputs","id":"Ki_BnhrDlP6s1RGEkRQI5","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"FloatProgress(value=0.0, layout=Layout(width='auto'), style=ProgressStyle(bar_color='black'))","content_type":"text/plain"},"application/vnd.jupyter.widget-view+json":{"content":"{\"version_major\":2,\"version_minor\":0,\"model_id\":\"49552f89d1494785adf1f35e287f3959\"}","content_type":"application/vnd.jupyter.widget-view+json"}}},"key":"G74ApCbgz9"}],"visibility":"show","key":"DbLtOm0MfR"}],"visibility":"show","key":"w4pBYuGf3d"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Perform the spatial subset. Extend the data bounds slightly.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FAxpJ2BJjf"}],"key":"zO1ZUs0l8x"}],"key":"hOwm0jbmFr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"extend = 1\ndf2 = df.query('latitude >= (@latS - @extend) & latitude <= (@latN + @extend) & longitude  >= (@lonW - @extend) & longitude <= (@lonE + @extend)')","key":"RoyhjYXnL7"},{"type":"outputs","id":"ZKMtGjFa1COT40suywuQE","children":[],"key":"vQ5FsCQXsX"}],"key":"Wyv1I43W4s"},{"type":"block","kind":"notebook-content","childre