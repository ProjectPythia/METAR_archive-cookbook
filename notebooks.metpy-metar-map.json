ne":1,"column":1},"end":{"line":1,"column":1}},"key":"nZATkW8E6d"},{"type":"text","value":", we pass in the arrays of the stations’ longitudes and latitudes. Since their units are in degrees, we need to also specify their corresponding map projection ... which is ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ntV7nPZIkd"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"PlateCarree","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TZ0vVwlnvw"}],"key":"RGwpfPTCvG"},{"type":"text","value":" for degrees of longitude and latitude.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FFErj5OXuI"}],"key":"WDETgcAS9c"}],"key":"iVF6QGXKnh"}],"key":"JEhlt82RK2"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Visualize Surface Observations","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gD17bZXHd5"}],"identifier":"visualize-surface-observations","label":"Visualize Surface Observations","html_id":"visualize-surface-observations","implicit":true,"key":"qqspilBSbf"}],"key":"w7PiZ5IS72"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Simple station plotting using plot methods","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HBKaKC9Hvf"}],"identifier":"simple-station-plotting-using-plot-methods","label":"Simple station plotting using plot methods","html_id":"simple-station-plotting-using-plot-methods","implicit":true,"key":"D9MPo5FGun"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"One way to create station plots with MetPy is to create an instance of ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"KnLKZzqxOR"},{"type":"inlineCode","value":"StationPlot","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"MP6m3cfnbC"},{"type":"text","value":" and call various plot methods, like ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"HKFTvKQuEK"},{"type":"inlineCode","value":"plot_parameter","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"pjLRB03fXq"},{"type":"text","value":", to plot arrays of data at locations relative to the center point.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OExvTjIGAh"}],"key":"IN8eGjv6HL"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"In addition to plotting values, ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"K5cQTyg7dc"},{"type":"inlineCode","value":"StationPlot","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"KOLcUQ5jSc"},{"type":"text","value":" has support for plotting text strings, symbols, and plotting values using custom formatting.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"EsLTAHpCHz"}],"key":"Jf1oWAZsv7"}],"key":"HqSwfEdJFu"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now we just plot with ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"id0n6H8nET"},{"type":"inlineCode","value":"arr[mask]","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vXPS3fQyg1"},{"type":"text","value":" for every ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QcSQfWZW6b"},{"type":"inlineCode","value":"arr","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UBvw1KElXE"},{"type":"text","value":" of data we use in plotting.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"C2rWnvw8nX"}],"key":"RLieZVhHDI"}],"key":"rvlGAjVog8"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"# Set up a plot with map features\n# First set dpi (\"dots per inch\") - higher values will give us a less pixelated final figure.\ndpi = 125\n\nfig = plt.figure(figsize=(20,12), dpi=dpi)\n\nax = fig.add_subplot(1, 1, 1, projection=proj_map) # We use the projection defined above\nax.set_facecolor(cfeature.COLORS['water'])\n\nland_mask = cfeature.NaturalEarthFeature('physical', 'land', '50m',\n                                        edgecolor='face',\n                                        facecolor=cfeature.COLORS['land'])\nlake_mask = cfeature.NaturalEarthFeature('physical', 'lakes', '50m',\n                                        edgecolor='face',\n                                        facecolor=cfeature.COLORS['water'])\nstate_borders = cfeature.NaturalEarthFeature(category='cultural', name='admin_1_states_provinces_lakes',\n                                         scale='50m', facecolor='none')\n\nax.add_feature(land_mask)\nax.add_feature(lake_mask)\nax.add_feature(state_borders, linestyle='solid', edgecolor='black')\n\nax.set_extent ((lonW, lonE, latS, latN), crs=proj_data)\n\n#If we wanted to add grid lines to our plot:\n#ax.gridlines()\n\n# Create a station plot pointing to an Axes to draw on as well as the location of points\nstationplot = StationPlot(ax, lons[mask], lats[mask], transform=ccrs.PlateCarree(),\n                          fontsize=8)\n\nstationplot.plot_parameter('NW', tair[mask], color='red', fontsize=10)\nstationplot.plot_parameter('SW', dewp[mask], color='darkgreen', fontsize=10)\n\n# Below, we are using a custom formatter to control how the sea-level pressure\n# values are plotted. This uses the standard trailing 3-digits of the pressure value\n# in tenths of millibars.\nstationplot.plot_parameter('NE', slp[mask], color='purple', formatter=lambda v: format(10 * v, '.0f')[-3:])\n\n\n\n#stationplot.plot_symbol('C', cloud_cover[mask], sky_cover)\n#stationplot.plot_symbol('W', wnum[mask], current_weather,color='blue',fontsize=12)\nstationplot.plot_text((2, 0),stid[mask], color='gray')\n#zorder - Higher value zorder will plot the variable on top of lower value zorder. This is necessary for wind barbs to appear. Default is 1.\nstationplot.plot_barb(u[mask], v[mask],zorder=2)\n\n# Remove any text that appears outside the borders of the Axes\n\nfor obj in ax.findobj(mtext.Text):\n    obj.set_clip_on(True)\nplotTitle = (f\"Sfc Map valid at:  {date_string}\")\nax.set_title (plotTitle);","key":"NYO7TqFQbM"},{"type":"outputs","id":"1ZIwPCBTExxGG9qMmSfoT","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stderr","text":"/home/runner/micromamba/envs/METAR_archive-cookbook/lib/python3.14/site-packages/cartopy/io/__init__.py:263: DownloadWarning: Downloading: https://naturalearth.s3.amazonaws.com/50m_physical/ne_50m_land.zip\n  warnings.warn(f'Downloading: {url}', DownloadWarning)\n"},"key":"iMoZvX7JsB"},{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stderr","text":"/home/runner/micromamba/envs/METAR_archive-cookbook/lib/python3.14/site-packages/cartopy/io/__init__.py:263: DownloadWarning: Downloading: https://naturalearth.s3.amazonaws.com/50m_physical/ne_50m_lakes.zip\n  warnings.warn(f'Downloading: {url}', DownloadWarning)\n"},"key":"tG1HCc5wOc"},{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stderr","text":"/home/runner/micromamba/envs/METAR_archive-cookbook/lib/python3.14/site-packages/cartopy/io/__init__.py:263: DownloadWarning: Downloading: https://naturalearth.s3.amazonaws.com/50m_cultural/ne_50m_admin_1_states_provinces_lakes.zip\n  warnings.warn(f'Downloading: {url}', DownloadWarning)\n"},"key":"xPbSI5bpdu"},{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 2500x1500 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"851de72c9b31fd70ef026661b4fbb5b0","path":"/METAR_archive-cookbook/build/851de72c9b31fd70ef026661b4fbb5b0.png"}}},"key":"rqiTpuWBt7"}],"key":"PCd52AC2Vv"}],"key":"EQ3vtbdXl8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZIYBwqL0O8"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"key":"vWTANEYfjD"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"You now know how to create surface maps from a constantly-updating archive of worldwide METAR observations.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"iaXaE0IT5x"}],"key":"xOmSBvYyGi"}],"key":"dXo36FSaGu"}],"key":"lET0HyYTgn"},{"type":"heading","depth":3,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Future work","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"q91b1cQfBf"}],"identifier":"future-work","label":"Future work","html_id":"future-work","implicit":true,"key":"sga2TalDHw"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"st