 data on a map.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kJodSg7WjJ"}],"key":"h5WvUmrnC2"}],"key":"UjNEjJgmq0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Uncomment whichever projection you want (or add your own!)\n#proj = ccrs.Stereographic(central_longitude=cLon, central_latitude=cLat)\nproj_map = ccrs.LambertConformal(central_longitude=cLon, central_latitude=cLat)","key":"tPwOaeJcCM"},{"type":"outputs","id":"PFKStf8cBhpsZL-jclMv9","children":[],"key":"YUlGPpcmHG"}],"key":"ESywzQPRnR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"proj_data = ccrs.PlateCarree()\nspacing = 150000 # meters; change depending on the map area\nxy = proj_map.transform_points(proj_data, lons, lats)\nmask = reduce_point_density(xy, spacing)","key":"KHnVRUS2ot"},{"type":"outputs","id":"Ms4lm-CaaHLi5-4C4Rzhr","children":[],"key":"idC7qLZDIo"}],"key":"owk2h9wKIv"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"tkMeqRgXm5"}],"key":"IUwTODBDyp"},{"type":"paragraph","children":[{"type":"text","value":"In the call to ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DuAysyxY0r"},{"type":"inlineCode","value":"transform_points","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jTySWaHJMM"},{"type":"text","value":", we pass in the arrays of the stations’ longitudes and latitudes. Since their units are in degrees, we need to also specify their corresponding map projection ... which is ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Z4T1psTY36"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"PlateCarree","position":{"start":{"line":1,"column":1