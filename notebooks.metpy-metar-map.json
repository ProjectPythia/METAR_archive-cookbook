c import wind_components, reduce_point_density\nfrom metpy.units import units\nfrom metpy.plots import StationPlot\nfrom metpy.plots.wx_symbols import current_weather, sky_cover, wx_code_map","key":"fTPhyDgWss"},{"type":"outputs","id":"PesMlyOE5oq_DOh7yCd5p","children":[],"key":"isKK6naDC6"}],"key":"fSShWCVVt2"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Set the domain to gather data from and for defining the plot region.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UCULdNlJAM"}],"identifier":"set-the-domain-to-gather-data-from-and-for-defining-the-plot-region","label":"Set the domain to gather data from and for defining the plot region.","html_id":"set-the-domain-to-gather-data-from-and-for-defining-the-plot-region","implicit":true,"key":"UhtKET34k5"}],"key":"tjmTPqflOm"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"latN = 55\nlatS = 20\nlonW = -125\nlonE = -60\n\ncLat = (latN + latS) / 2\ncLon = (lonW + lonE) / 2","key":"hDgIzVPnP1"},{"type":"outputs","id":"4OkeGHvNOjeQnV9FxUNXA","children":[],"key":"LFTktg5VDk"}],"key":"V4A50g1gFE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Use the current time, or set your own for a past time.\n# Set current to False if you want to specify a past time.\n\nnowTime = datetime.now()\n\ncurrent = True\n#current = False\nif (current):\n    time_1 = datetime.now()\n    offset = timedelta(hours = 1) # Worldwide METARS typically don't come in until ~15 minutes past the hour\n    time_1 = time_1 - offset\nelse:\n    year = 2026\n    month = 6\n    day = 18\n    hour = 18\n    time_1 = datetime(year, month, day, hour)","key":"Yur1eaucme"},{"type":"outputs","id":"ufCBKo_YstjN06tRKKC7W","children":[],"key":"IYueXhbI9z"}],"key":"MilQ9tkrf9"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The timestamps of many hourly METAR reports are 5-10 minutes prior to the top of the hour, though there are also intra-hourly reports, often around 15-20 and 35-40 minutes past the hour. When we make our DuckDB query, we will specify a beginning and end time, 15 minutes apart.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"X9A1oKj1nI"}],"key":"fhTls6DVwm"}],"key":"F17wXe7pTV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"time_0 = time_1 - timedelta(minutes=15)\nYYYY_0 = time_0.strftime(\"%Y\")\nYYYY_1 = time_1.strftime(\"%Y\")\ndate_string = time_1.strftime(\"%Y-%m-%d %H00 UTC\")\nprint(time_0, time_1)\n# Handle edge case when the two hours straddle the end/beginning of a yearw\nif (YYYY_0 == YYYY_1):\n    URLs = [f'https://data.source.coop/dynamical/asos-parquet/year={YYYY_1}/data.parquet']\nelse:\n    URLs = [f'https://data.source.coop/dynamical/asos-parquet/year={YYYY_0}/data.parquet',\n            f'https://data.source.coop/dynamical/asos-parquet/year={YYYY_1}/data.parquet']\n","key":"fqGmMt0ugK"},{"type":"outputs","id":"oJ-ySNRq8g8zVJgzszeyR","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"2026-11-27 06:40:25.796271 2026-11-27 06:55:25.796271\n"},"key":"DSLs8WlL3B"}],"key":"pm51SonmAM"}],"key":"wdPA6G5fpr"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Open the GeoParquet file for the specific year.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"B208vpSlR9"}],"identifier":"open-the-geoparquet-file-for-the-specific-year","label":"Open the GeoParquet file for the specific year.","html_id":"open-the-geoparquet-file-for-the-specific-year","implicit":true,"key":"z6SsbHHn32"}],"key":"fNSbZARVXP"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"df = duckdb.execute(\"\"\"\n    SELECT *\n    FROM read_parquet($1, hive_partitioning=true)\n    WHERE \n---      country = 'FR' AND\n---    station = 'ENGM' AND\n    valid BETWEEN $2 AND $3\n    ORDER BY country\n\"\"\", [URLs, time_0, time_1]).fetchdf()","visibility":"show","key":"QLtLg1vXoK"},{"type":"outputs","id":"xrjhFKRzfuWZ68y50i8t7","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"FloatProgress(value=0.0, layout=Layout(width='auto'), style=ProgressStyle(bar_color='black'))","content_type":"text/plain"},"application/vnd.jupyter.widget-view+json":{"content":"{\"version_major\":2,\"version_minor\":0,\"model_id\":\"9bd0f7f2ab1841879ff14130f5a394db\"}","content_type":"application/vnd.jupyter.widget-view+json"}}},"key":"H0KLv919vy"}],"visibility":"show","key":"LZYKX2Cb1n"}],"visibility":"show","key":"idiSjFi3dl"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Perform the spatial subset. Extend the data bounds slightly.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"viM1dhISKF"}],"key":"koTV7FFvSD"}],"key":"xxUkRPmRKA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"extend = 1\ndf2 = df.query('latitude >= (@latS - @extend) & latitude <= (@latN + @extend) & longitude  >= (@lonW - @extend) & longitude <= (@lonE + @extend)')","key":"cHPcTWR0lY"},{"type":"outputs","id":"ykOPD1E2x2k0dYHORClhy","children":[],"key":"KulKy8cCkC"}],"key":"KejqprLZE7"},{"type":"block","kind":"notebook-content","childre