"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Select a Cartopy map projection, which we will use both to reduce plotted station density and to plot the data on a map.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WColwK3Ez9"}],"key":"UKvLNxGaQq"}],"key":"qZzhDaRtb8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Uncomment whichever projection you want (or add your own!)\n#proj = ccrs.Stereographic(central_longitude=cLon, central_latitude=cLat)\nproj_map = ccrs.LambertConformal(central_longitude=cLon, central_latitude=cLat)","key":"IOLw8WukQg"},{"type":"outputs","id":"iqpTrK-9NExhhjuIUxkgO","children":[],"key":"nopIyqe4i6"}],"key":"hbDDGululN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"proj_data = ccrs.PlateCarree()\nspacing = 150000 # meters; change depending on the map area\nxy = proj_map.transform_points(proj_data, lons, lats)\nmask = reduce_point_density(xy, spacing)","key":"T8ChUbWiOV"},{"type":"outputs","id":"bhygk_tkny415boQ4etuX","children":[],"key":"pmDAX7V40s"}],"key":"l5wLRrDD6n"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"ss8t1R4QrR"}],"key":"xhxJSHXLgy"},{"type":"paragraph","children":[{"type":"text","value":"In the call to ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uZm1IPzOfE"},{"type":"inlineCode","value":"transform_points","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RkdY7u0sf2"},{"type":"text","value":", we pass in the arrays of the stations’ longitudes and latitudes. Since their units are in degrees, we need to also specify their corresponding map projection ... which is ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":